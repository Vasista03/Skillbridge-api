# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. For Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/skillbridge

# Secret used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# JWT signing algorithm. HS256 is fine for a single-service backend.
JWT_ALGORITHM=HS256

# Lifetime of the normal login JWT.
ACCESS_TOKEN_EXPIRE_HOURS=24

# Pre-shared key required to mint a monitoring scoped token.
MONITORING_API_KEY=monitoring-secret-key

# Lifetime of the short-lived monitoring scoped token.
MONITORING_TOKEN_EXPIRE_MINUTES=60
